<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <title><%= projectName %> | PhysicsLab</title>
    <link rel="stylesheet" href="<%= cssUrl %>">
    <link rel="icon" href="favicon.ico">
    <style>
      html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #142a38; }
      #GameDiv { width: 100%; height: 100%; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
      #GameCanvas { display: block; touch-action: none; }
    </style>
  </head>
  <body>
    <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" tabindex="0" aria-label="风暴弓手 PhysicsLab"></canvas>
      </div>
    </div>
    <%- include(cocosTemplate, {}) %>
  </body>
</html>
