{
  "name": "storm-archers",
  "version": "3.8.8",
  "private": true,
  "description": "风暴弓手 — Cocos Creator 3.8.8 PhysicsLab",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "check:config": "node --import tsx tools/config/cli.ts check",
    "config:generate": "node --import tsx tools/config/cli.ts generate",
    "config:check-generated": "node --import tsx tools/config/cli.ts check-generated",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:engine": "node scripts/creator.mjs typecheck",
    "verify": "node scripts/verify.mjs",
    "env:check": "node scripts/creator.mjs inspect",
    "build:web": "node scripts/creator.mjs build-web",
    "test:web:t002": "node scripts/verify-t002-web.mjs",
    "test:web:t003": "node scripts/verify-t003-web.mjs",
    "test:web:t004-t006": "node scripts/verify-t004-t006-web.mjs",
    "test:web:t004": "node scripts/verify-t004-web.mjs",
    "test:web:release": "node scripts/verify-t004-web.mjs --release-only",
    "handoff:report": "node scripts/handoff.mjs",
    "test:web:arm-impact": "node scripts/verify-arm-impact-web.mjs",
    "test:web:arcade": "node scripts/verify-arcade-web.mjs",
    "test:web:arcade-stability": "node scripts/verify-arcade-stability-web.mjs",
    "check:syntax": "node scripts/check-engine-syntax.mjs",
    "typecheck:engine-source": "node scripts/typecheck-engine-source.mjs"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "type": "module",
  "creator": {
    "version": "3.8.8"
  },
